# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# SESSION_SECRET: Secret key used to sign admin session tokens and cookies.
SESSION_SECRET="CHANGE_ME_TO_A_RANDOM_64_CHAR_HEX_STRING"

# DATABASE_DRIVER: "sqlite" (built-in zero-config) or "mysql" (production MySQL 8.0)
DATABASE_DRIVER="sqlite"

# Optional MySQL 8.0 Production Configuration
MYSQL_HOST="127.0.0.1"
MYSQL_PORT="3306"
MYSQL_USER="codefather"
MYSQL_PASSWORD=""
MYSQL_DATABASE="the_codefather"

# Backup Retention Policy (days)
BACKUP_RETENTION_DAYS="30"
